# Variables para `docker compose up` (levanta Postgres + backend + frontend
# juntos). Copiar a `.env` (gitignoreado) y completar antes de correr
# compose -- las dos primeras no tienen default, docker compose se niega a
# arrancar sin ellas.

# Password de Postgres dentro del contenedor (no tiene que ser el mismo
# que uses en un Postgres local nativo).
DB_PASSWORD=

# Secreto para firmar los JWT, mínimo 32 bytes. NO reutilizar el valor de
# ejemplo que trae application.properties para desarrollo local sin
# Docker -- generar uno nuevo, por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET=

# Clave AES-256 para cifrar at-rest el contenido de las historias clínicas
# (diagnóstico/tratamiento/observaciones). Debe decodificar a exactamente
# 32 bytes en Base64 -- generar con:
#   openssl rand -base64 32
# NO reutilizar el default de desarrollo de application.properties.
ENCRYPTION_KEY=

# El resto tiene default razonable en docker-compose.yml; solo hace falta
# tocarlos si vas a exponer esto fuera de tu máquina.
# JWT_EXPIRATION_MS=86400000
# COOKIE_SECURE=false
# ALLOWED_ORIGIN_PATTERNS=http://localhost:*
# BACKEND_PORT=8080
# FRONTEND_PORT=80
# VITE_API_URL=http://localhost:8080
